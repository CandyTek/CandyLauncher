// 独立皮肤编辑器的资源：图标与内嵌的编辑器页面
#include "common/Resource.h"
#include "common/AppVersion.h"
#include "windows.h"

IDI_CANDYLAUNCHER ICON "icons/CandyLauncher.ico"
IDR_SKIN_EDITOR_HTML RCDATA "web/skin_editor.html"

// 版本号与主程序共用 CMake project(VERSION)
VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_RC
 PRODUCTVERSION APP_VERSION_RC
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CandyTek"
            VALUE "FileDescription", "CandyLauncher Skin Editor"
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "InternalName", "SkinEditor"
            VALUE "LegalCopyright", "Copyright (C) 2025 CandyTek"
            VALUE "OriginalFilename", "SkinEditor.exe"
            VALUE "ProductName", "CandyLauncher"
            VALUE "ProductVersion", APP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
