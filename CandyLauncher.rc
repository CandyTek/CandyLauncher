IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 480, 350
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,375,310,50,14
    PUSHBUTTON      "取消",IDCANCEL,430,310,50,14
    // 其他控件...
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "common/app.manifest"
IDR_SETTINGS_JSON RCDATA "common/settings.json"
IDR_SKIN_EDITOR_HTML RCDATA "web/skin_editor.html"

/////////////////////////////////////////////////////////////////////////////
//
// 版本信息（资源管理器“详细信息”页、安装/更新工具读取的就是这里）
// 数值来自 CMake project(VERSION)，不要在此手改
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_RC
 PRODUCTVERSION APP_VERSION_RC
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CandyTek"
            VALUE "FileDescription", "CandyLauncher"
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "InternalName", "CandyLauncher"
            VALUE "LegalCopyright", "Copyright (C) 2025 CandyTek"
            VALUE "OriginalFilename", "CandyLauncher.exe"
            VALUE "ProductName", "CandyLauncher"
            VALUE "ProductVersion", APP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
